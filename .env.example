# Copie ce fichier en ".env" en local, ou renseigne ces mêmes variables
# dans l'onglet "Variables" de ton service Railway.

# Récupérés sur developers.tiktok.com, dans ton app > Credentials
TIKTOK_CLIENT_KEY=colle_ta_client_key_ici
TIKTOK_CLIENT_SECRET=colle_ton_client_secret_ici

# Doit être EXACTEMENT la même URL que celle enregistrée dans Login Kit
# sur developers.tiktok.com (https, sans paramètres)
TIKTOK_REDIRECT_URI=https://tondomaine.com/auth/tiktok/callback

# Une longue chaîne aléatoire, unique à ton projet (sert à sécuriser les sessions)
SESSION_SECRET=change_moi_avec_une_longue_chaine_aleatoire

# Fournie automatiquement par Railway quand tu ajoutes une base PostgreSQL
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/nomdb

# Railway définit PORT automatiquement, inutile d'y toucher en production
PORT=3000
NODE_ENV=development
